{
  "manifest_version": 3,
  "name": "瞬搜 · QuickSwitch",
  "version": "1.1.0",
  "description": "像 Arc 一样快速搜索、打开网址、切换已有标签。默认 ⌘E，支持本地浏览历史匹配。",
  "minimum_chrome_version": "127",
  "incognito": "not_allowed",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "history",
    "search",
    "favicon",
    "storage"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+E"
      },
      "description": "打开 / 关闭瞬搜面板"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
